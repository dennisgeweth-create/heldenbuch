Options -Indexes

# Kein Cache für HTML – Browser soll immer neu laden
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# PHP-Dateien schützen (außer api.php)
<FilesMatch "^(?!api\.php$).*\.php$">
  Order Deny,Allow
  Deny from all
</FilesMatch>
